# =============================================================================
# منظومة العزب — قالب متغيرات البيئة للإنتاج (Alazab production env template)
#
# القواعد:
#   1. انسخ هذا الملف إلى `.env` على السيرفر فقط. لا تضع أي مفتاح حقيقي هنا.
#   2. `.env` متجاهَل في Git (قاعدة `.env*` في .gitignore) — لا تتجاوزها.
#   3. المفاتيح الحقيقية تُحفظ في Azure Key Vault / أسرار CI / Docker secrets
#      وتُحقن وقت النشر.
#   4. توليد الأسرار:  openssl rand -hex 32   (JWT_*, MEILI_MASTER_KEY, ADMIN_PANEL_SESSION_SECRET)
#                      openssl rand -hex 32   (CREDS_KEY: 64 hex)
#                      openssl rand -hex 16   (CREDS_IV: 32 hex)
#   5. القيم الفارغة هنا يجب ملؤها قبل التشغيل في الإنتاج.
# =============================================================================

#---------------------------------#
# الخادم والنطاق                  #
#---------------------------------#
HOST=0.0.0.0
PORT=3080
NODE_ENV=production

# النطاق العام (HTTPS إلزامي في الإنتاج)
DOMAIN_CLIENT=https://chat.alazab.com
DOMAIN_SERVER=https://chat.alazab.com

# عدد الـ reverse proxies أمام التطبيق (nginx/Caddy/Azure Front Door = 1)
TRUST_PROXY=1
NO_INDEX=true

# مسار ملف الإعدادات داخل الحاوية (يُركَّب من librechat.alazab.yaml)
CONFIG_PATH=/app/librechat.yaml

# صلاحيات الملفات لـ docker compose (نفّذ: id -u / id -g)
UID=1000
GID=1000

#---------------------------------#
# قاعدة البيانات والبحث            #
#---------------------------------#
# فعّل المصادقة في MongoDB ثم ضع المستخدم وكلمة المرور هنا
# docker-compose.prod.yml يبني MONGO_URI من المتغيرين التاليين (openssl rand -hex 24 لكلمة المرور)
MONGO_USER=alazab_admin
MONGO_PASSWORD=
# للتشغيل بدون compose.prod فقط:
# MONGO_URI=mongodb://USER:PASSWORD@mongodb:27017/LibreChat?authSource=admin

MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=

# قاعدة المتجهات (RAG) — بدّل القيم الافتراضية mydatabase/myuser/mypassword
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

#---------------------------------#
# الأسرار الأساسية                #
#---------------------------------#
# يجب أن تكون ثابتة ودائمة؛ تغييرها يُنهي الجلسات ويُفقد البيانات المشفرة
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# لوحة الإدارة (32 حرفاً على الأقل)
ADMIN_PANEL_URL=https://chat.alazab.com/admin
ADMIN_PANEL_SESSION_SECRET=
ADMIN_PANEL_SESSION_COOKIE_SECURE=true

#---------------------------------#
# التسجيل والدخول                 #
#---------------------------------#
# أداة داخلية للشركة: أغلق التسجيل المفتوح وأنشئ المستخدمين بالدعوة أو الأمر
#   npm run create-user / npm run invite-user
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
ENFORCE_TWO_FACTOR_AUTHENTICATION=false
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# البريد (مطلوب لإعادة تعيين كلمة المرور والتحقق)
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENCRYPTION=starttls
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Alazab AI

#---------------------------------#
# النقاط المعروضة                 #
#---------------------------------#
# المزوّدات المخصصة (Azure/DeepSeek/Ollama) تُعرَّف في librechat.alazab.yaml
ENDPOINTS=agents,google,custom

#---------------------------------#
# مزودو النماذج — المفاتيح فقط    #
#---------------------------------#
# Azure OpenAI (az-ai-resource) — endpoint: https://az-ai-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=

# Azure API Management (az-ai-gateway) — اختياري، يُستخدم إن مررنا الحركة عبر البوابة
# endpoint: https://az-ai-gateway.azure-api.net/az-ai-resource/openai/v1
AZURE_APIM_SUBSCRIPTION_KEY=

# DeepSeek المباشر
DEEPSEEK_API_KEY=

# Ollama (ollama.alazab.com) — إن لم يكن خلف مصادقة ضع القيمة الشكلية: ollama
OLLAMA_API_KEY=

# Google Gemini — مفتاح واحد للخادم (لا تستخدم user_provided في بيئة الشركة)
GOOGLE_KEY=
# حدد النماذج صراحةً إن فشل التوليد بـ 404 (اسم النموذج غالباً هو السبب):
# GOOGLE_MODELS=

# OpenAI المباشر — معطّل حالياً (الرصيد منتهٍ، يرجع 429). أعد تفعيله بعد الشحن:
# OPENAI_API_KEY=

#---------------------------------#
# MCP — بوابة العزب               #
#---------------------------------#
# رمز مصادقة البوابة https://mcp.alazab.com (يُرسَل كـ Authorization: Bearer)
MCP_GATEWAY_TOKEN=

#---------------------------------#
# RAG                             #
#---------------------------------#
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000

# openssl rand -hex 32
# openssl rand -hex 32
# openssl rand -hex 16

# --- الصور والنسخ الاحتياطي (docker-compose.prod.yml) ---
IMAGE_TAG=
ADMIN_PANEL_IMAGE_TAG=latest
RAG_IMAGE_TAG=latest
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- منافذ loopback على المضيف (docker-compose.prod.yml) ---
# تأكد أنها حرة: ss -tlnp | grep -E ':(3080|3002)\b'
LIBRECHAT_HOST_PORT=3080
ADMIN_PANEL_HOST_PORT=3002

# --- حدود الموارد (خادم إنتاج مشترك مع فرابي وخدمات أخرى) ---
# الإجمالي الافتراضي ~11.5GB ذاكرة سقفًا (الاستهلاك الفعلي أقل بكثير). عدّلها بعد المراقبة بـ docker stats.
API_MEM_LIMIT=3g
API_NODE_HEAP_MB=2048
ADMIN_MEM_LIMIT=512m
MONGO_MEM_LIMIT=3g
MONGO_CACHE_GB=1.5
MEILI_MEM_LIMIT=2g
MEILI_MAX_INDEXING_MEMORY=1Gb
PG_MEM_LIMIT=1g
RAG_MEM_LIMIT=2g

# نطاق شبكة Docker الداخلية (ثابت لتفادي التعارض مع Calico وشبكات الخادم الأخرى)
LIBRECHAT_SUBNET=172.29.88.0/24
