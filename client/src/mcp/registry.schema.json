{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlazabDev/az-codex/mcp/registry.schema.json",
  "title": "Az Codex MCP Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "enabled", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["mcp-server", "openapi", "plugin", "knowledge"]
          },
          "enabled": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 },
          "spec": { "type": "string", "minLength": 1 },
          "manifest": { "type": "string", "minLength": 1 },
          "catalog": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "mcp-server" } } },
            "then": { "required": ["entry"] }
          },
          {
            "if": { "properties": { "kind": { "const": "openapi" } } },
            "then": { "required": ["spec"] }
          },
          {
            "if": { "properties": { "kind": { "const": "plugin" } } },
            "then": { "required": ["manifest"] }
          },
          {
            "if": { "properties": { "kind": { "const": "knowledge" } } },
            "then": { "required": ["catalog"] }
          }
        ]
      }
    }
  }
}
