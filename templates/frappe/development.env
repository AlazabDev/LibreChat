# az-codex Frappe development profile
# Installed into <bench>/.azcodex/frappe.env

AZCODEX_FRAPPE_ENV=development
AZCODEX_FRAPPE_SITE=

# No interactive approval. Safety is enforced by backup + fail-closed behavior.
AZCODEX_REQUIRE_MANUAL_APPROVAL=0

# Back up before schema/data-changing or destructive bench operations.
AZCODEX_BACKUP_BEFORE_MIGRATE=1
AZCODEX_BACKUP_BEFORE_DESTRUCTIVE=1
AZCODEX_BACKUP_WITH_FILES=1

# Development sites may perform destructive operations after a successful backup.
AZCODEX_ALLOW_DROP_SITE=1
AZCODEX_ALLOW_REINSTALL=1
AZCODEX_ALLOW_RESTORE=1

# Never allow the agent to treat upstream framework apps as project code.
AZCODEX_PROTECTED_APPS=frappe,erpnext
