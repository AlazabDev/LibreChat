# az-codex Frappe production profile
# Installed into <bench>/.azcodex/frappe.env when production mode is selected.

AZCODEX_FRAPPE_ENV=production
AZCODEX_FRAPPE_SITE=

# No interactive approval. Production safety is enforced by policy.
AZCODEX_REQUIRE_MANUAL_APPROVAL=0

# Always back up before migration or destructive operations.
AZCODEX_BACKUP_BEFORE_MIGRATE=1
AZCODEX_BACKUP_BEFORE_DESTRUCTIVE=1
AZCODEX_BACKUP_WITH_FILES=1

# Production defaults: migrate is allowed after a successful backup;
# destructive site replacement/deletion operations are blocked.
AZCODEX_ALLOW_DROP_SITE=0
AZCODEX_ALLOW_REINSTALL=0
AZCODEX_ALLOW_RESTORE=0

AZCODEX_PROTECTED_APPS=frappe,erpnext
